# ---------------------------------------------------------------------
# Archivum — environment variables
# Copy to .env.local for local work. In production these live in
# Vercel > Settings > Environment Variables.
# NEVER commit a filled-in copy of this file.
# ---------------------------------------------------------------------

# --- Supabase (Dashboard > Settings > API) ---------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# Server-only. Bypasses Row Level Security. Never prefix this NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# --- Data source switch ----------------------------------------------
# 'mock' serves the twenty built-in demo records with no database.
# 'supabase' serves the live catalog.
NEXT_PUBLIC_DATA_SOURCE=supabase

# --- Source platform tokens (server-only) ----------------------------
# Both are optional for public data but raise rate limits substantially.
HF_TOKEN=hf_xxxxxxxxxxxx
GITHUB_TOKEN=github_pat_xxxxxxxxxxxx

# --- Admin ------------------------------------------------------------
# Comma-separated. Compared server-side against the signed-in user's email.
ADMIN_EMAILS=archivumllc@gmail.com

# --- App --------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Scheduled refresh ------------------------------------------------
# Any long random string. Vercel Cron sends it as a bearer token.
CRON_SECRET=change-me-to-a-long-random-string

# --- Deliberately absent ---------------------------------------------
# No STRIPE_* variables. Billing is not implemented in this version.
